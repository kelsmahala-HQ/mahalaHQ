NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only — never prefix with NEXT_PUBLIC_. Used only in onboarding/actions.ts
# to create/join a household after independently verifying the caller's session.
SUPABASE_SECRET_KEY=your-secret-key

# Server-only. From dashboard.plaid.com/team/keys. Used for the Round-Up page's
# optional bank-linking feature. Start with your Sandbox client_id/secret and
# PLAID_ENV=sandbox; switch PLAID_ENV=production once Plaid approves production access.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox

# Server-only. From resend.com/api-keys. Used to send "join our household" invite emails.
RESEND_API_KEY=your-resend-api-key

# Public — used to build links inside emails (e.g. the invite email). Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://mahalahq.org

# Web push notifications (calendar reminders, chore assignments). Generate a real pair with
# `npx web-push generate-vapid-keys` — never reuse the placeholder pair below in production.
# Must also be added to Netlify's own environment variables dashboard, not just this file.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Server-only. From console.anthropic.com/settings/keys. Used by the Recipe Box's
# "Import a recipe" feature to turn a pasted URL or recipe text into structured
# ingredients/instructions. Must also be added to Netlify's own environment
# variables dashboard, not just this file.
ANTHROPIC_API_KEY=your-anthropic-api-key
