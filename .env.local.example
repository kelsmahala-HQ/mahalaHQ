NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only — never prefix with NEXT_PUBLIC_. Used only in onboarding/actions.ts
# to create/join a household after independently verifying the caller's session.
SUPABASE_SECRET_KEY=your-secret-key

# Server-only. From dashboard.plaid.com/team/keys. Used for the Round-Up page's
# optional bank-linking feature. Start with your Sandbox client_id/secret and
# PLAID_ENV=sandbox; switch PLAID_ENV=production once Plaid approves production access.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox
